rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, email verified, and a @bu.edu address
    function isBuStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@bu[.]edu$');
    }

    function isMe(uid) {
      return isBuStudent() && request.auth.uid == uid;
    }

    function isInChat(chatId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    // In a finished deal, the other person may mark your listing sold and change nothing else.
    // soldInChatId names the deal's chat, and both of you must be in it.
    function isSoldInSharedChat() {
      let chat = get(/databases/$(database)/documents/chats/$(request.resource.data.soldInChatId)).data;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'soldInChatId'])
        && request.resource.data.status == 'SOLD'
        && request.auth.uid in chat.participantIds
        && resource.data.ownerId in chat.participantIds;
    }

    // A review must be about a deal you finished together: both of you are in the chat,
    // and promptId is that chat's "Deal done" message. The id is promptId_reviewer, and
    // reviews can't be edited, so each person reviews each finished deal once.
    function isReviewOfMyFinishedDeal(reviewId) {
      let review = request.resource.data;
      let people = get(/databases/$(database)/documents/chats/$(review.chatId)).data.participantIds;
      let prompt = get(/databases/$(database)/documents/chats/$(review.chatId)/messages/$(review.promptId)).data;
      return review.fromUserId == request.auth.uid
        && review.toUserId != request.auth.uid
        && request.auth.uid in people
        && review.toUserId in people
        && prompt.type == 'REVIEW_PROMPT'
        && reviewId == review.promptId + '_' + request.auth.uid
        && review.stars is int && review.stars >= 1 && review.stars <= 5
        && review.text is string && review.text.size() <= 300;
    }

    // Profiles: any student can read, only you can write yours
    match /users/{uid} {
      allow read: if isBuStudent();
      allow create, update: if isMe(uid);
    }

    // Hearts: private to each student
    match /users/{uid}/saved/{listingId} {
      allow read, write: if isMe(uid);
    }

    // Listings: any student can read, only the owner can create or edit.
    // The one exception: the other person in a finished deal can mark it sold.
    match /listings/{listingId} {
      allow read: if isBuStudent();
      allow create: if isBuStudent() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBuStudent()
        && (resource.data.ownerId == request.auth.uid || isSoldInSharedChat());
    }

    // Chats and deals: only the two people in the chat
    match /chats/{chatId} {
      allow read, update: if isBuStudent() && request.auth.uid in resource.data.participantIds;
      allow create: if isBuStudent() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isBuStudent() && isInChat(chatId);
        allow create: if isBuStudent() && isInChat(chatId)
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Reviews: any student can read. You can only review someone you finished a deal with, once.
    match /reviews/{reviewId} {
      allow read: if isBuStudent();
      allow create: if isBuStudent() && isReviewOfMyFinishedDeal(reviewId);
    }
  }
}
