rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in, email verified, and a @bu.edu address
    function isBuStudent() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@bu[.]edu$');
    }

    function isMe(uid) {
      return isBuStudent() && request.auth.uid == uid;
    }

    function isInChat(chatId) {
      return request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    // Profiles: any student can read, only you can write yours
    match /users/{uid} {
      allow read: if isBuStudent();
      allow create, update: if isMe(uid);
    }

    // Listings: any student can read, only the owner can create or edit
    match /listings/{listingId} {
      allow read: if isBuStudent();
      allow create: if isBuStudent() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isBuStudent() && resource.data.ownerId == request.auth.uid;
    }

    // Chats and deals: only the two people in the chat
    match /chats/{chatId} {
      allow read, update: if isBuStudent() && request.auth.uid in resource.data.participantIds;
      allow create: if isBuStudent() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if isBuStudent() && isInChat(chatId);
        allow create: if isBuStudent() && isInChat(chatId)
          && request.resource.data.senderId == request.auth.uid;
      }
    }

    // Reviews: any student can read, you can only write reviews from yourself
    match /reviews/{reviewId} {
      allow read: if isBuStudent();
      allow create: if isBuStudent() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}